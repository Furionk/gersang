extends SceneTree
const Files = preload("../core/files.gd")
const Profile = preload("../core/profile.gd")
const Packager = preload("../core/package.gd")
const Publisher = preload("../core/publish.gd")
const Analyzer = preload("../core/analyzer.gd")
var passed:int=0
var failed:int=0
func check(ok:bool,label:String) -> void:
	if ok: passed+=1; print("PASS ",label)
	else: failed+=1; push_error(label)
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var folder:String=ProjectSettings.globalize_path("res://artifacts/core-tests/"+str(Time.get_ticks_usec()))
	var native:String=folder.path_join("native")
	var profile:Dictionary=Profile.defaults(); profile.project_id="a".repeat(32); profile.output=folder.path_join("output"); profile.compression="gzip"
	check(Profile.validate(profile).is_empty(),"valid profile")
	var invalid:Dictionary=profile.duplicate(true); invalid.output="res://"; check(not Profile.validate(invalid).is_empty(),"project root rejected")
	invalid=profile.duplicate(true); invalid.chunk_mib=8; check(not Profile.validate(invalid).is_empty(),"chunk bounds")
	check(not Files.relative_safe("../save.dat") and not Files.relative_safe("C:/game"),"path confinement")
	var wasm:PackedByteArray=[]; wasm.resize(2500000); wasm.fill(42)
	Files.write(native.path_join("index.wasm"),wasm)
	Files.write(native.path_join("index.pck"),"first pack".to_utf8_buffer())
	Files.write(native.path_join("index.js"),"// native engine".to_utf8_buffer())
	Files.write(native.path_join("index.audio.worklet.js"),"// worklet".to_utf8_buffer())
	var html:String=FileAccess.get_file_as_string("res://addons/web_export/web/shell.html").replace("$GODOT_URL","index.js").replace("$GODOT_CONFIG","{}").replace("$GODOT_HEAD_INCLUDE","")
	Files.write(native.path_join("index.html"),html.to_utf8_buffer())
	var analysis:Dictionary=Analyzer.analyze(profile)
	check(analysis.resources.has("res://main.tscn"),"main scene dependency root")
	var stage:String=folder.path_join("stage1")
	var events:Array=[]
	var callback:Callable=func(label:String,current:int,total:int,unit:String): events.append({"label":label,"current":current,"total":total,"unit":unit})
	var first:Dictionary=Packager.build(native,stage,profile,analysis,callback)
	check(not events.is_empty() and events[-1].current==wasm.size()+10 and events[-1].current==events[-1].total,"packaging reports real processed bytes")
	check(Packager.build(native,folder.path_join("cancelled-stage"),profile,analysis,Callable(),func():return true).has("error"),"packaging cancellation")
	check(not first.has("error"),"gzip package builds")
	if first.has("error"): quit(1); return
	var manifest:Dictionary=Files.json_read(stage.path_join("releases/"+str(first.release)+"/manifest.json"))
	var joined:PackedByteArray=[]
	for part:Dictionary in manifest.files[0].parts:
		var bytes:PackedByteArray=FileAccess.get_file_as_bytes(stage.path_join(part.url))
		if part.encoding=="gzip": bytes=bytes.decompress(int(part.bytes),FileAccess.COMPRESSION_GZIP)
		joined.append_array(bytes)
	check(joined==wasm,"gzip chunk reconstruction")
	check(first.server_bytes<first.decoded_pack_bytes,"wire-size accounting")
	var result:Dictionary=Publisher.publish(stage,profile.output,profile,first)
	check(not result.has("error"),"first publication")
	check(FileAccess.get_file_as_string(str(profile.output).path_join("index.html"))==FileAccess.get_file_as_string(stage.path_join("index.html")),"entry matches verified stage")
	var repeated:Dictionary=Publisher.publish(stage,profile.output,profile,first.duplicate(true))
	check(not repeated.has("error") and repeated.get("delta_transfer_bytes",-1)==0,"unchanged release has zero upload delta")
	var known_html:String=FileAccess.get_sha256(str(profile.output).path_join("index.html"))
	invalid=profile.duplicate(true); invalid.project_id="b".repeat(32)
	check(Publisher.publish(stage,profile.output,invalid,first).has("error"),"foreign project output rejected")
	check(known_html==FileAccess.get_sha256(str(profile.output).path_join("index.html")),"failed publication preserves previous entry")
	var other:String=folder.path_join("unowned"); Files.write(other.path_join("important.txt"),"keep".to_utf8_buffer())
	check(Publisher.publish(stage,other,profile,first).has("error"),"nonempty unowned output rejected")
	for n:int in range(2,4):
		Files.write(native.path_join("index.pck"),("pack "+str(n)).to_utf8_buffer())
		var next_stage:String=folder.path_join("stage"+str(n))
		var next:Dictionary=Packager.build(native,next_stage,profile,analysis)
		var published:Dictionary=Publisher.publish(next_stage,profile.output,profile,next)
		check(not published.has("error"),"publish changed release "+str(n))
		check(published.get("delta_transfer_bytes",99999999)<first.decoded_pack_bytes,"unchanged engine reused "+str(n))
	var preview:Dictionary=Publisher.candidates(profile.output,profile.project_id)
	check(not preview.files.is_empty(),"old-only owned objects identified")
	var before:String=FileAccess.get_sha256(str(profile.output).path_join("index.html"))
	Files.write(str(profile.output).path_join("user-note.txt"),"keep me".to_utf8_buffer())
	var entry_file:String=str(profile.output).path_join("index.html")
	var current_html:PackedByteArray=FileAccess.get_file_as_bytes(entry_file)
	Files.copy_verified(stage.path_join("index.html"),entry_file)
	var recovery:Dictionary=Publisher.candidates(profile.output,profile.project_id)
	var live_safe:bool=true
	for path:String in recovery.files:
		if first.files.has(path): live_safe=false
	check(live_safe,"cleanup preserves live entry when registry is ahead after interrupted publish")
	var recovery_audit:Dictionary=Publisher.inspect_output(profile.output,profile.project_id)
	check(recovery_audit.get("object_audit",{}).get("release","")==first.release and recovery_audit.object_audit.current_valid,"audit follows live HTML when registry is ahead")
	Files.write(entry_file,current_html)
	var clean:Dictionary=Publisher.clean(profile.output,profile.project_id)
	check(not clean.has("error") and FileAccess.get_file_as_string(str(profile.output).path_join("user-note.txt"))=="keep me","cleanup preserves unowned files")
	check(before==FileAccess.get_sha256(str(profile.output).path_join("index.html")),"cleanup preserves current entry")

	var output:String=str(profile.output)
	var audit:Dictionary=Publisher.inspect_output(output,profile.project_id,"",callback)
	check(not audit.has("error") and audit.object_audit.current_valid and audit.object_audit.retained_valid,"audit verifies raw and gzip hashes")
	check(not audit.object_audit.latest_only and not audit.object_audit.retained.is_empty(),"retained old chunks distinguished from current-only output")
	check(events[-1].current==events[-1].total and events[-1].unit=="files","audit reports actual file progress")
	check(Publisher.inspect_output(output,"wrong").has("error"),"audit rejects foreign owner")
	check(Publisher.inspect_output(output,profile.project_id,"",Callable(),func():return true).has("error"),"audit cancellation")

	var retained:String=audit.object_audit.retained[0]
	var retained_bytes:PackedByteArray=FileAccess.get_file_as_bytes(output.path_join(retained))
	DirAccess.remove_absolute(output.path_join(retained))
	var partial_history:Dictionary=Publisher.inspect_output(output,profile.project_id)
	check(partial_history.object_audit.current_valid and not partial_history.object_audit.retained_valid and partial_history.object_audit.latest_only,"missing history distinguished from clean current-only objects")
	check(not Publisher.inspect_output(output,profile.project_id,folder.path_join("current-with-missing-history")).has("error"),"current upload remains possible with missing historical chunks")
	Files.write(output.path_join(retained),retained_bytes)
	var chunk:String=audit.object_audit.current[0]
	var bytes:PackedByteArray=FileAccess.get_file_as_bytes(output.path_join(chunk))
	Files.write(output.path_join(chunk),"damaged".to_utf8_buffer())
	var damaged:Dictionary=Publisher.inspect_output(output,profile.project_id)
	check(not damaged.object_audit.current_valid and chunk in damaged.object_audit.corrupt,"corrupt current object detected")
	check(Publisher.inspect_output(output,profile.project_id,folder.path_join("bad-upload")).has("error"),"corrupt current release cannot produce upload copy")
	DirAccess.remove_absolute(output.path_join(chunk))
	var missing:Dictionary=Publisher.inspect_output(output,profile.project_id)
	check(not missing.object_audit.current_valid and chunk in missing.object_audit.missing,"missing object detected")
	Files.write(output.path_join(chunk),bytes)
	Files.write(output.path_join("objects/.hidden-junk"),"unknown".to_utf8_buffer())
	Files.write(output.path_join("objects/.hidden-dir/secret"),"keep".to_utf8_buffer())
	Files.write(output.path_join("FONT-LICENSE.txt"),"sample licence".to_utf8_buffer())
	var messy:Dictionary=Publisher.inspect_output(output,profile.project_id)
	check(messy.object_audit.current_valid and "objects/.hidden-junk" in messy.object_audit.unknown and "objects/.hidden-dir/" in messy.object_audit.unknown,"hidden files and directories cannot escape audit")
	var bundle:Dictionary=Publisher.inspect_output(output,profile.project_id,folder.path_join("upload"),callback)
	check(not bundle.has("error") and bundle.object_audit.latest_only,"clean upload has only current verified objects")
	check(FileAccess.file_exists(output.path_join("objects/.hidden-junk")) and FileAccess.file_exists(output.path_join("objects/.hidden-dir/secret")),"upload copy preserves source unknown files")
	check(not FileAccess.file_exists(folder.path_join("upload/user-note.txt")) and FileAccess.file_exists(folder.path_join("upload/FONT-LICENSE.txt")),"upload copy excludes notes but preserves licence sidecars")
	check(bundle.upload_files[-1]=="index.html","upload list puts entry last")
	check(Publisher.inspect_output(output,profile.project_id,folder.path_join("upload")).has("error"),"existing upload destination refused")
	check(Publisher.inspect_output(output,profile.project_id,output.path_join("nested")).has("error"),"nested upload destination refused")
	check(Publisher.inspect_output(output,profile.project_id,folder).has("error"),"ancestor upload destination refused")
	check(FileAccess.get_sha256(output.path_join("index.html"))==before,"audit and upload never replace source entry")
	Files.json_write(output.path_join(".web-export-lock/owner.json"),{"pid":OS.get_process_id()})
	check(Publisher.inspect_output(output,profile.project_id).has("error"),"audit respects active publisher lock")
	DirAccess.remove_absolute(output.path_join(".web-export-lock/owner.json")); DirAccess.remove_absolute(output.path_join(".web-export-lock"))
	# UI owns no gameplay references and can attach to an arbitrary test root.
	var script:Script=load("res://addons/web_export/panel.gd")
	var panel:Window=script.new(); var rock:Node=Node.new(); rock.name="LiteralRock"; root.add_child(rock); rock.add_child(panel)
	check(panel.get_child_count()>0,"editor panel standalone construction")
	panel.show_progress({"message":"Copy","current":2,"total":4,"unit":"files"})
	check(panel.progress_bar.value==50 and not panel.progress_bar.indeterminate,"panel displays measured phase progress")
	panel.show_progress({"message":"Native export","total":0})
	check(panel.progress_bar.indeterminate,"native phase shows indeterminate progress")
	panel.shutdown(); rock.queue_free()
	print("WEB_EXPORT_CORE_RESULT passed=",passed," failed=",failed)
	quit(1 if failed else 0)
