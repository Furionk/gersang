extends Node
var passed: int = 0
var failures: Array[String] = []
func _ready() -> void: call_deferred("run")
func check(value: bool, label: String) -> void:
	if value: passed+=1; print("PASS | ",label)
	else: failures.append(label); push_error("FAIL | "+label)
func run() -> void:
	WorldCatalog.initialize()
	var before_root: WorldMap2D = preload("res://tests/world/legacy_scene_fixture.gd").load_scene("res://artifacts/river-enrichment-2026-10-10/river-before.tscn").instantiate() as WorldMap2D
	var root: WorldMap2D = ResourceLoader.load("res://features/world/data/river_bay.tscn","PackedScene",ResourceLoader.CACHE_MODE_IGNORE).instantiate() as WorldMap2D
	var old: WorldMapDefinition = before_root.compile_definition()
	var map: WorldMapDefinition = root.compile_definition()
	check(map.portals==old.portals and map.entries==old.entries and map.roads==old.roads and map.landmarks==old.landmarks,"all portal positions including approved town entry and landmarks unchanged")
	var geometry: bool = true
	for field: String in ["walkable","blockers","safe_areas"]:
		var a: Array = old.get(field)
		var b: Array = map.get(field)
		geometry = geometry and a.size()==b.size()
		for index: int in a.size(): geometry = geometry and a[index].outer==b[index].outer and a[index].holes==b[index].holes
	check(geometry,"every planar navigation contour/hole unchanged; visual water retains old collisions")
	check(map.habitats.size()==old.habitats.size(),"all four monster regions preserved")
	for habitat: WorldHabitat in old.habitats:
		var current: WorldHabitat = map.habitat(habitat.habitat_id)
		check(current.profile.target_party_count==habitat.profile.target_party_count and current.profile.arena_pool==habitat.profile.arena_pool,"monster population and battlefield unchanged "+habitat.habitat_id)
	var ground: WorldTileLayer = root.get_node("Ground/Ground_TileMap") as WorldTileLayer
	check(ground.get_used_cells().size()==24576,"all 24,576 ground cells survive palette pattern paint")
	var cells_valid: bool = true
	for cell: Vector2i in ground.get_used_cells(): cells_valid = cells_valid and ground.get_cell_tile_data(cell)!=null and ground.get_cell_alternative_tile(cell)>=0
	check(cells_valid,"all native cells have valid atlas alternatives (no black holes)")
	check(ground.tile_set.resource_path=="res://features/world/data/tiles/river_bay_enriched.tres","native enriched TileSet is external reviewable resource")
	check(ground.tile_set.get_source(1).texture.resource_path=="res://art/terrain/native_tiles/river_biome_details.png","derived palette uses imported texture, not embedded pixel blob")
	var parent: Node2D = root.get_node("Scenery/RiverComposition") as Node2D
	check(parent.y_sort_enabled,"native editor composition inherits Y sorting")
	check(map.scenery.size()>1000 and map.scenery.size()>old.scenery.size()*5,"large-map scenery density substantially increased")
	var ownership: bool = true
	var spacing: bool = true
	var portal_clear: bool = true
	var groups: Dictionary = {}
	for node: Node in WorldAuthorTree.nodes(parent):
		if node is Node2D and not node is WorldAuthorNode and not node is Sprite2D: ownership = ownership and node.y_sort_enabled
		if not node is WorldAuthorNode: continue
		groups[node.get_parent().name] = true
		ownership = ownership and node.owner==root and node.get_node("Artwork").owner==root and node.coordinate_space==WorldAuthorNode.CoordinateSpace.CANVAS
		var point: Vector2 = WorldAuthorTree.logical_position(node,root)
		for portal: Dictionary in map.portals: portal_clear = portal_clear and point.distance_to(portal.point)>140
		if node.stable_id=="river_detail_bridge": continue
		for route: PackedVector2Array in map.roads:
			for index: int in range(1,route.size()):
				spacing = spacing and Geometry2D.get_closest_point_to_segment(point,route[index-1],route[index]).distance_to(point)>=90
	check(ownership,"all decorative nodes/Artwork have scene owners and editable native groups")
	check(groups.size()==6,"six meaningful environment/life groups instead of anonymous flat clutter")
	check(spacing and portal_clear,"new scenery respects route and portal visibility corridors")
	check(root.has_node("Technical/OldRiverRockDecor") and root.get_node("Technical/OldRiverRockDecor").get_child_count()==21,"21 old autogenerated river rocks archived, not destructively deleted")
	var validation: Array[String] = WorldValidator.validate(map,WorldCatalog.definitions,root)
	check(validation.is_empty(),"full native map validation "+str(validation))
	var snapshot: Dictionary = WorldAuthoringSnapshot.compile(root)
	check(snapshot.ok and snapshot.errors.is_empty() and snapshot.definition.scenery.size()==map.scenery.size(),"detached editor snapshot preserves nested native composition")
	var packed: PackedScene = PackedScene.new()
	check(packed.pack(root)==OK and ResourceSaver.save(packed,"res://artifacts/river-enrichment-2026-10-10/roundtrip.tscn")==OK,"enriched scene saves with complete native owners")
	var reloaded: WorldMap2D = ResourceLoader.load("res://artifacts/river-enrichment-2026-10-10/roundtrip.tscn","PackedScene",ResourceLoader.CACHE_MODE_IGNORE).instantiate() as WorldMap2D
	check(reloaded.compile_definition().portals==map.portals and reloaded.compile_definition().scenery.size()==map.scenery.size(),"save/reopen preserves routes and dense sprite composition")
	var report: Dictionary = {"passed":passed,"failed":failures.size(),"failures":failures,"scenery_before":old.scenery.size(),"scenery_after":map.scenery.size(),"floor_cells":ground.get_used_cells().size(),"manual_editor_acceptance":"unverified"}
	var file: FileAccess = FileAccess.open("res://artifacts/river-enrichment-2026-10-10/results.json",FileAccess.WRITE)
	file.store_string(JSON.stringify(report,"\t")); file.close()
	print("RIVER_ENRICHMENT_RESULT ",JSON.stringify(report))
	reloaded.free(); root.free(); before_root.free()
	get_tree().quit(0 if failures.is_empty() else 1)
