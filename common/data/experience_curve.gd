class_name ExperienceCurve
extends Resource
@export var max_level: int = 100
@export var source: String = "https://www.52jushang.com/qita/zhandou_exp.asp"
# Cumulative column, Lv.1 through Lv.100; do not sum the source's inconsistent next-level column.
@export var cumulative: PackedInt64Array = PackedInt64Array([
	0,20,50,100,180,300,470,700,1000,1380,
	1850,2430,3210,4280,5730,7650,10130,13260,17130,21830,
	27450,34080,41810,50740,60970,72600,85730,100460,116890,135120,
	155250,177380,201660,228240,257270,288900,323280,360560,400890,444420,
	491330,541680,595760,653740,715820,782200,853080,928660,1009140,1094720,
	1185600,1281980,1384110,1492240,1606620,1727500,1855130,1989760,2131640,2281020,
	2438150,2603280,2776710,2958740,3169670,3349800,3559430,3778860,4008390,4248320,
	4498950,4760580,5033610,5318440,5615470,5925100,6247730,6583760,6933590,7297620,
	7676250,8069880,8479010,8904140,9345770,9804400,10280530,10774660,11287290,11818920,
	12370050,12941180,13533310,14147440,14784570,15445700,16131830,16843960,17583090,18350220])
func threshold(level: int) -> int:
	return cumulative[clampi(level, 1, mini(max_level, cumulative.size())) - 1]
func level_for(experience: int) -> int:
	var result: int = 1
	while result < mini(max_level, cumulative.size()) and experience >= threshold(result + 1):
		result += 1
	return result
